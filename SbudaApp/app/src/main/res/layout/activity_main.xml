<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D14">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aperta se és corajoso"
        android:textColor="#8A8A9A"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="72dp" />

    <!-- Glow atrás do botão -->
    <View
        android:id="@+id/glow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_glow"
        app:layout_constraintTop_toTopOf="@id/btnBig"
        app:layout_constraintBottom_toBottomOf="@id/btnBig"
        app:layout_constraintStart_toStartOf="@id/btnBig"
        app:layout_constraintEnd_toEndOf="@id/btnBig" />

    <!-- Botão gigante vermelho -->
    <FrameLayout
        android:id="@+id/btnBig"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/btn_red_selector"
        android:elevation="16dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="APERTA"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </FrameLayout>

    <!-- Card com a mensagem revelada -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="64dp"
        app:cardBackgroundColor="#1A1A24"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        android:visibility="invisible"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
